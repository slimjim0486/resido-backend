# ─── App ───
APP_NAME=Vemix
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-use-a-long-random-string

# ─── Database (Railway provides DATABASE_URL; raw postgresql:// is auto-normalized) ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vemix
# Optional sync override for Alembic; derived from DATABASE_URL when blank:
SYNC_DATABASE_URL=

# ─── Redis (optional; app degrades gracefully without it) ───
REDIS_URL=redis://localhost:6379/0

# ─── JWT ───
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── AI: Claude (agent) ───
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Embeddings (Voyage default; OpenAI optional) ───
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-large
OPENAI_API_KEY=

# ─── Ingestion / AI search ───
FIRECRAWL_API_KEY=
EXA_API_KEY=
APIFY_TOKEN=

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
